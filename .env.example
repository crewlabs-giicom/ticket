JWT_SECRET=ganti-dengan-secret-key-yang-kuat-minimal-32-karakter
APP_NAME=TicketingApp
NODE_ENV=production
PORT=3000

# MikroTik (modul Jaringan, read-only). Pakai user read-only di router.
NUXT_ROUTEROS_HOST=
NUXT_ROUTEROS_PORT=8729
NUXT_ROUTEROS_USER=
NUXT_ROUTEROS_PASSWORD=
NUXT_ROUTEROS_TLS=true
NUXT_ROUTEROS_REJECT_UNAUTHORIZED=false
NUXT_ROUTEROS_CACHE_MS=3000
# true = pakai data contoh, router tidak dihubungi
NUXT_ROUTEROS_MOCK=false
# Kualitas koneksi WAN: router mem-ping tiap WAN ke target ini (dipisah koma). Ambang dalam ms / persen.
NUXT_ROUTEROS_PING_TARGETS=1.1.1.1,8.8.8.8
NUXT_ROUTEROS_PING_INTERVAL_SEC=30
NUXT_ROUTEROS_PING_LATENCY_WARN=100
NUXT_ROUTEROS_PING_LATENCY_BAD=200
NUXT_ROUTEROS_PING_JITTER_WARN=30
NUXT_ROUTEROS_PING_JITTER_BAD=60
NUXT_ROUTEROS_PING_LOSS_WARN=2
NUXT_ROUTEROS_PING_LOSS_BAD=5
